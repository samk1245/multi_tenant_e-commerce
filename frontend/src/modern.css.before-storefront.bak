@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: "DM Sans", sans-serif;
  color: #172033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  --brand: #2457e6;
  --brand-dark: #173db0;
  --ink: #172033;
  --muted: #697386;
  --line: #e7eaf1;
  --surface: #ffffff;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; background: #f5f7fb; color: var(--ink); }
button, input, select, textarea { font: inherit; }
a { color: inherit; }
#root { min-height: 100vh; }
#root > div { min-height: 100vh; }

nav {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 15px 24px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  box-shadow: 0 3px 18px rgba(23,32,51,.035);
}
nav a {
  display: inline-flex;
  align-items: center;
  padding: 10px 15px;
  border-radius: 9px;
  color: #39445b;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: background .2s, color .2s;
}
nav a:hover { color: var(--brand); background: #edf2ff; }

h1, h2, h3 { font-family: "Manrope", sans-serif; letter-spacing: -.035em; }
button, input, textarea, select { border-radius: 9px; }
button { cursor: pointer; }
input, textarea, select {
  border: 1px solid #dce2ed;
  padding: 12px 14px;
  background: #fff;
  color: var(--ink);
}
input:focus, textarea:focus, select:focus {
  outline: 3px solid rgba(36,87,230,.12);
  border-color: var(--brand);
}
button {
  border: 0;
  padding: 11px 17px;
  background: var(--brand);
  color: white;
  font-weight: 700;
  transition: transform .15s, background .15s;
}
button:hover { background: var(--brand-dark); }
button:active { transform: translateY(1px); }

.store-home { max-width: 1240px; margin: 0 auto; padding: 30px 28px 0; }
.store-hero {
  min-height: 430px;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  align-items: center;
  gap: 20px;
  overflow: hidden;
  position: relative;
  padding: 54px 6%;
  border-radius: 25px;
  color: #fff;
  background: linear-gradient(120deg, #12254d 0%, #1e43a3 58%, #3867ef 100%);
  box-shadow: 0 18px 48px rgba(34,70,160,.18);
}
.hero-copy { position: relative; z-index: 2; max-width: 590px; }
.eyebrow { display: inline-block; color: #7394ff; font-size: 11px; font-weight: 800; letter-spacing: .16em; }
.store-hero .eyebrow { color: #b9cbff; }
.hero-copy h1 { margin: 18px 0; font-size: clamp(34px, 4.2vw, 57px); line-height: 1.13; font-weight: 800; }
.hero-copy h1 span { color: #9fbcff; }
.hero-copy > p { max-width: 470px; color: #d7e1ff; font-size: 16px; line-height: 1.8; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 27px; }
.btn-primary, .btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  min-height: 46px;
  padding: 0 20px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  transition: transform .2s, box-shadow .2s;
}
.btn-primary { color: #fff; background: var(--brand); box-shadow: 0 8px 18px rgba(36,87,230,.2); }
.store-hero .btn-primary { color: #18316c; background: #fff; box-shadow: none; }
.btn-secondary { color: #fff; border: 1px solid rgba(255,255,255,.32); background: rgba(255,255,255,.08); }
.btn-primary:hover, .btn-secondary:hover { transform: translateY(-2px); }
.hero-trust { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 29px; color: #d7e1ff; font-size: 12px; }
.hero-art { min-height: 310px; display: flex; align-items: center; justify-content: center; position: relative; }
.hero-orbit { position: absolute; width: 300px; height: 300px; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; }
.orbit-two { width: 230px; height: 230px; border-style: dashed; }
.hero-product { display: grid; place-items: center; position: absolute; border: 1px solid rgba(255,255,255,.5); background: rgba(255,255,255,.96); box-shadow: 0 20px 45px rgba(0,0,0,.16); }
.product-main { width: 145px; height: 145px; border-radius: 34px; font-size: 75px; transform: rotate(-8deg); }
.product-small { width: 76px; height: 76px; border-radius: 23px; top: 26px; right: 5%; font-size: 39px; transform: rotate(9deg); }
.product-side { width: 85px; height: 85px; border-radius: 24px; bottom: 24px; left: 5%; font-size: 42px; transform: rotate(8deg); }
.hero-floating { position: absolute; right: 0; bottom: 15px; padding: 14px 17px; border: 1px solid rgba(255,255,255,.35); border-radius: 13px; background: rgba(10,25,65,.45); color: #e1e9ff; font-size: 12px; line-height: 1.6; }

.store-benefits { display: grid; grid-template-columns: repeat(4,1fr); gap: 15px; margin: 22px 0 48px; }
.store-benefits > div { display: flex; align-items: center; gap: 13px; padding: 18px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
.store-benefits > div > span { display: grid; place-items: center; flex-shrink: 0; width: 43px; height: 43px; border-radius: 12px; background: #edf2ff; font-size: 21px; }
.store-benefits strong { font-size: 12px; }
.store-benefits p { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
.store-section { margin-bottom: 48px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 23px; }
.section-heading h2 { margin: 7px 0; font-size: 29px; }
.section-heading p { margin: 0; color: var(--muted); font-size: 14px; }
.text-link { color: var(--brand); font-size: 13px; font-weight: 800; text-decoration: none; white-space: nowrap; }
.category-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 17px; }
.category-card { min-height: 185px; position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 24px; overflow: hidden; border: 1px solid var(--line); border-radius: 17px; background: #fff; text-decoration: none; transition: transform .2s, box-shadow .2s; }
.category-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(23,32,51,.08); }
.category-icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 17px; border-radius: 15px; background: #eef2ff; font-size: 27px; }
.category-2 .category-icon { background: #fff0e6; }
.category-3 .category-icon { background: #e8f8ee; }
.category-4 .category-icon { background: #f5eaff; }
.category-card > strong { font-size: 15px; }
.category-detail { margin-top: 7px; color: var(--muted); font-size: 12px; }
.category-arrow { position: absolute; top: 20px; right: 20px; color: #8b95a8; }
.store-feature { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 42px 6%; border-radius: 21px; background: #eaf0ff; }
.store-feature h2 { margin: 10px 0; font-size: clamp(28px,3vw,39px); line-height: 1.2; }
.store-feature p { max-width: 530px; margin-bottom: 23px; color: #5d6880; font-size: 14px; line-height: 1.8; }
.feature-symbol { display: grid; place-items: center; flex-shrink: 0; width: 150px; height: 150px; border: 1px solid #d2ddff; border-radius: 36px; background: #fff; color: var(--brand); font-size: 95px; box-shadow: 0 14px 35px rgba(36,87,230,.1); transform: rotate(8deg); }
.store-footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding: 28px 2px; margin-top: 15px; color: var(--muted); font-size: 12px; }
.store-footer strong { color: var(--ink); font-size: 13px; }
.store-footer a { color: var(--brand); font-weight: 700; text-decoration: none; }

@media (max-width: 850px) {
  .store-home { padding: 18px 16px 0; }
  .store-hero { grid-template-columns: 1fr; padding: 40px 7%; }
  .hero-art { min-height: 245px; }
  .hero-orbit { width: 235px; height: 235px; }
  .orbit-two { width: 180px; height: 180px; }
  .store-benefits { grid-template-columns: repeat(2,1fr); margin-bottom: 38px; }
  .category-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 480px) {
  nav { justify-content: flex-start; gap: 2px; padding: 10px; }
  nav a { padding: 9px 10px; font-size: 12px; }
  .store-hero { border-radius: 17px; padding: 31px 22px; }
  .hero-copy h1 { font-size: 35px; }
  .hero-copy > p { font-size: 14px; }
  .hero-trust { gap: 9px; font-size: 10px; }
  .store-benefits { gap: 9px; }
  .store-benefits > div { padding: 11px; gap: 8px; }
  .store-benefits > div > span { width: 34px; height: 34px; font-size: 17px; }
  .store-benefits strong { font-size: 11px; }
  .store-benefits p { font-size: 10px; }
  .section-heading { align-items: flex-start; flex-direction: column; }
  .section-heading h2 { font-size: 25px; }
  .category-grid { gap: 10px; }
  .category-card { min-height: 160px; padding: 16px; }
  .store-feature { padding: 28px 22px; }
  .feature-symbol { width: 75px; height: 75px; border-radius: 20px; font-size: 48px; }
  .store-footer { flex-direction: column; align-items: flex-start; }
}
